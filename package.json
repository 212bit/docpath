{
  "name": "docpath",
  "version": "0.1.1",
  "description": "文径 DocPath — 渐进式文档驱动工作流 (Document as Finite State Machine)",
  "type": "module",
  "bin": {
    "docpath": "./bin/docpath.js"
  },
  "files": [
    "dist/",
    "dashboard-dist/",
    "templates/"
  ],
  "scripts": {
    "build": "pnpm run build:clean",
    "build:clean": "tsup --clean",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "build:test": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "test": "pnpm run build:test && node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@vitejs/plugin-react": "4.5.2",
    "cac": "^6.7.14",
    "minimatch": "^10.2.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2",
    "vite": "6.3.5",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
