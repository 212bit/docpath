{
  "name": "docpath",
  "version": "0.2.0",
  "description": "文径 DocPath — 渐进式文档驱动工作流 (Document as Finite State Machine)",
  "type": "module",
  "bin": {
    "docpath": "./bin/docpath.js"
  },
  "files": [
    "dist/",
    "templates/"
  ],
  "scripts": {
    "build": "pnpm run build:clean",
    "build:clean": "tsup --clean",
    "build:test": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "test": "pnpm run build:test && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "cac": "^6.7.14",
    "cli-table3": "^0.6.5",
    "minimatch": "^10.2.5",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
