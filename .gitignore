# Dependencies
/node_modules/

# Build output
/dist/

# DocPath workspace
#
# Keep .docpath ignored by default. Runtime state, generated indexes, installed
# adapter mirrors, backlog, and task evidence can be very large/noisy.
# When a task requires durable evidence, run `docpath changes --agent` and
# force-add only the exact canonical paths it recommends.
/.docpath/

# Local agent/tool state
/.claude/
/.sisyphus/

# DocPath worktrees
/.worktrees/

