# Dependencies
/node_modules
/.pnpm-store/

# Build output
/dist/

# DocPath runtime state
#
# Merge-mediated resources (backlog, rules, tasks/done) stay tracked; isolated runtime
# (workspace, tasks/current) stays gitignored per worktree.
/.docpath/workspace/
/.docpath/.install-meta.json
/.docpath/tasks/current/

# Local agent/tool state
/.claude/
/.sisyphus/
/.opencode/node_modules/
/.dsh-vision-router/

# Local agent/tool scratch
/.cowork-temp/
/.workbuddy/
/.playwright-mcp/

# DocPath worktrees
/.worktrees/
.docpath/bin/docpath
.docpath/tasks/promote-backups/
