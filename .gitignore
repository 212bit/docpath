# Dependencies
/node_modules/

# Build output
/dist/

# DocPath runtime state
#
# Keep local runtime files out of Git while leaving durable DocPath evidence
# such as backlog items, completed tasks, rules, protocols, and templates visible.
/.docpath/workspace/
/.docpath/.install-meta.json
/.docpath/tasks/current/

# Local agent/tool state
/.claude/
/.sisyphus/

# DocPath worktrees
/.worktrees/
